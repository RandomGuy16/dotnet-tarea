@model IEnumerable<MiBotica.SolPedido.Entidades.Core.Cliente>

@{
    ViewBag.Title = "Clientes";
}

<h2>Clientes</h2>
<p>@Html.ActionLink("Insertar cliente", "Create")</p>

<table class="table">
    <tr>
        <th>Código</th>
        <th>Nombre completo</th>
        <th>Zona</th>
    </tr>
@foreach (var cliente in Model)
{
    <tr>
        <td>@Html.DisplayFor(modelItem => cliente.Codigo)</td>
        <td>@Html.DisplayFor(modelItem => cliente.NombreCompleto)</td>
        <td>@Html.DisplayFor(modelItem => cliente.Zona)</td>
    </tr>
}
</table>
