@model MiBotica.SolPedido.Entidades.Core.Cliente

@{
    ViewBag.Title = "Insertar cliente";
}

<h2>Insertar cliente</h2>

@using (Html.BeginForm("Insertar", "Cliente", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(model => model.Codigo)
        @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.NombreCompleto)
        @Html.EditorFor(model => model.NombreCompleto, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Zona)
        @Html.EditorFor(model => model.Zona, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <input type="submit" value="Guardar" class="btn btn-primary" />
}
