<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MiBotica.SolPedido.Cliente.Web</RootNamespace>
    <AssemblyName>MiBotica.SolPedido.Cliente.Web</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Abstractions" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web.Routing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiBotica.SolPedido.AccesoDatos\MiBotica.SolPedido.AccesoDatos.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.Entidades\MiBotica.SolPedido.Entidades.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.LogicaNegocio\MiBotica.SolPedido.LogicaNegocio.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.Utiles\MiBotica.SolPedido.Utiles.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.UtilesWeb\MiBotica.SolPedido.UtilesWeb.csproj" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.Razor" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebPages" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageReference Include="Microsoft.Web.Infrastructure" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Global.asax" />
    <Content Include="Web.config" />
    <Content Include="Content\**\*" />
    <Content Include="Scripts\**\*" />
    <Content Include="Views\**\*" />
    <Content Include="wwwroot\**\*" />
    <Content Include="App_Start\**\*" />
  </ItemGroup>
</Project>
