<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>MiBotica.SolPedido.Cliente.Web</RootNamespace>
    <AssemblyName>MiBotica.SolPedido.Cliente.Web</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiBotica.SolPedido.AccesoDatos\MiBotica.SolPedido.AccesoDatos.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.Entidades\MiBotica.SolPedido.Entidades.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.LogicaNegocio\MiBotica.SolPedido.LogicaNegocio.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.Utiles\MiBotica.SolPedido.Utiles.csproj" />
    <ProjectReference Include="..\MiBotica.SolPedido.UtilesWeb\MiBotica.SolPedido.UtilesWeb.csproj" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views\**\*" />
    <Content Include="wwwroot\**\*" />
    <None Include="appsettings*.json" />
    <None Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
