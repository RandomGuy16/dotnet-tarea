<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="SQL"
         connectionString="Server=localhost,1433;Database=BDPedido;User Id=sa;******;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="cnnSql" value="SQL" />
    <add key="apiBaseUrl" value="http://localhost:5044" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Login/Index" />
    </authentication>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <customErrors mode="On">
      <error statusCode="500" redirect="~/Home/Error500" />
      <error statusCode="404" redirect="~/Home/PaginaNoEncontrada" />
    </customErrors>
  </system.web>
</configuration>
